# FinPilot environment — copy to .env and adjust.
# All values here are development defaults; never commit real secrets.

# PostgreSQL connection (any PostgreSQL 16+ server).
# Default matches the project-managed embedded dev database (`npm run db:start`).
# To use your own local PostgreSQL service instead, point this at it, e.g.
#   postgres://postgres:<your-password>@localhost:5432/finpilot
DATABASE_URL=postgres://finpilot:finpilot@localhost:5433/finpilot

# Server-side secret for salted hashes (IP hashes, rate-limit subject hashes).
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-random-32-byte-secret

# Where the dev mailer writes outgoing "emails" as JSON files (password resets).
# Leave unset to default to .dev-mail/ in the project root. Not used in production.
# DEV_MAIL_DIR=.dev-mail

# Base URL used in generated links (password reset). Defaults to http://localhost:3000
# In production this MUST be the real public origin — reset links point at it.
# APP_BASE_URL=http://localhost:3000

# Structured-log verbosity (pino): trace|debug|info|warn|error. Defaults to info.
# LOG_LEVEL=info

# Production deployment (container image, release steps, required variables):
# see docs/ops/deployment.md.
